// calcolo dei fattoriali in parallelo

int const n = 5 ;
int result[n] ;
int i = 0 ;
int j = 0 ;
int fact(int x){
    if (x == 0) { 1 } else { x*fact(x-1) }
    }

mapred ( i upto n: result[i] = fact(i))
while (j < n) {
    result[0] = result[0] + result[j] ;
    j = j+1 ;
}

result[0];


